# Copy this file to ".env" and fill in ONE provider.

# Which provider to use: openai | groq | gemini
LLM_PROVIDER=groq

# Only fill in the key for the provider you chose above.
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: override the default model for your chosen provider
# MODEL=llama-3.3-70b-versatile
